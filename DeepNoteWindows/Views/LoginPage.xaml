<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeepNoteWindows.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepNoteWindows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Padding="24" HorizontalAlignment="Center">
            <TextBlock Text="DeepNote" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="議事録アプリ" FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="1">
            <!-- ログインボタン（WebView非表示時） -->
            <StackPanel x:Name="LoginPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <Button x:Name="GoogleSignInButton"
                        Click="OnGoogleSignInClick"
                        HorizontalAlignment="Center"
                        Padding="24,12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8A7;" />
                        <TextBlock Text="Googleでログイン" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ErrorText"
                           Foreground="Red"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- WebView2 for OAuth -->
            <WebView2 x:Name="AuthWebView"
                      Visibility="Collapsed"
                      NavigationStarting="OnNavigationStarting" />

            <!-- ローディング -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock x:Name="StatusText"
                           Text="認証中..."
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- フッター -->
        <TextBlock Grid.Row="2"
                   Text="© 2026 DeepNote"
                   FontSize="12"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24" />
    </Grid>
</Page>
