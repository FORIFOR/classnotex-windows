<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeepNoteWindows.Views.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepNoteWindows.Views"
    xmlns:vm="using:DeepNoteWindows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnBackClick" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" />
            </Button>

            <StackPanel Grid.Column="1" Margin="16,0">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" FontSize="13" Foreground="Gray" />
            </StackPanel>

            <TextBlock x:Name="ElapsedTimeText"
                       Grid.Column="2"
                       FontSize="24"
                       FontFamily="Consolas"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- 録音コントロール -->
        <Grid Grid.Row="1" Padding="24,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <!-- 録音ボタン -->
                <Button x:Name="RecordButton"
                        Click="OnRecordClick"
                        Width="120"
                        Height="48">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="RecordIndicator"
                                 Width="12" Height="12"
                                 Fill="Red" />
                        <TextBlock x:Name="RecordButtonText" Text="録音開始" />
                    </StackPanel>
                </Button>

                <!-- チャンク数 -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="Gray">チャンク数</TextBlock>
                    <TextBlock x:Name="ChunkCountText" FontSize="18" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </StackPanel>

            <!-- 処理中インジケータ -->
            <ProgressRing x:Name="ProcessingRing"
                          Grid.Column="1"
                          IsActive="False"
                          Width="32" Height="32" />
        </Grid>

        <!-- トランスクリプト表示 -->
        <ListView x:Name="ChunksListView"
                  Grid.Row="2"
                  Padding="24,8"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TranscriptChunkDisplay">
                    <Grid Padding="8" Margin="0,4"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind StartTime}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="Gray"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0" />

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Text}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 手動入力 -->
        <Grid Grid.Row="3" Padding="24,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ManualInputBox"
                     Grid.Column="0"
                     PlaceholderText="テキストを手動入力..."
                     KeyDown="OnManualInputKeyDown" />

            <Button Grid.Column="1"
                    Click="OnSendManualTextClick"
                    Margin="8,0,0,0">
                <FontIcon Glyph="&#xE724;" />
            </Button>
        </Grid>

        <!-- 完了ボタン -->
        <Grid Grid.Row="4" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="SummaryCheckBox" Content="要約生成" IsChecked="True" />
                <CheckBox x:Name="PlaylistCheckBox" Content="再生リスト" IsChecked="True" />
                <CheckBox x:Name="QuizCheckBox" Content="クイズ生成" IsChecked="False" />
            </StackPanel>

            <Button Grid.Column="1"
                    Click="OnFinalizeClick"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock Text="セッション完了" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- エラー表示 -->
        <InfoBar x:Name="ErrorInfoBar"
                 Grid.RowSpan="5"
                 Severity="Error"
                 IsOpen="False"
                 VerticalAlignment="Top"
                 Margin="24,80,24,0" />
    </Grid>
</Page>
