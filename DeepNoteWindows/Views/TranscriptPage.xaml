<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeepNoteWindows.Views.TranscriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepNoteWindows.Views"
    xmlns:models="using:DeepNoteWindows.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnBackClick" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" />
            </Button>

            <StackPanel Grid.Column="1" Margin="16,0">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="StatusText" FontSize="13" Foreground="Gray" />
                    <TextBlock x:Name="CountText" FontSize="13" Foreground="Gray" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Click="OnRefreshClick" ToolTipService.ToolTip="更新">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!-- 要約セクション -->
        <Expander x:Name="SummaryExpander"
                  Grid.Row="1"
                  Header="要約"
                  Margin="24,0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Visibility="Collapsed">
            <Grid Padding="8">
                <!-- 生成中 -->
                <StackPanel x:Name="SummaryGeneratingPanel"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="要約を生成中..." VerticalAlignment="Center" Foreground="Gray" />
                </StackPanel>

                <!-- エラー -->
                <StackPanel x:Name="SummaryErrorPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="SummaryErrorText"
                               Foreground="Red"
                               TextWrapping="Wrap" />
                    <Button Click="OnRetrySummaryClick" Content="再試行" />
                </StackPanel>

                <!-- 内容 -->
                <ScrollViewer x:Name="SummaryContentPanel" MaxHeight="200" Visibility="Collapsed">
                    <TextBlock x:Name="SummaryText"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Expander>

        <!-- クイズセクション -->
        <Expander x:Name="QuizExpander"
                  Grid.Row="2"
                  Header="クイズ"
                  Margin="24,4,24,0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Visibility="Collapsed">
            <Grid Padding="8">
                <!-- 生成中 -->
                <StackPanel x:Name="QuizGeneratingPanel"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="クイズを生成中..." VerticalAlignment="Center" Foreground="Gray" />
                </StackPanel>

                <!-- エラー -->
                <StackPanel x:Name="QuizErrorPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="QuizErrorText"
                               Foreground="Red"
                               TextWrapping="Wrap" />
                    <Button Click="OnRetryQuizClick" Content="再試行" />
                </StackPanel>

                <!-- 内容 -->
                <ScrollViewer x:Name="QuizContentPanel" MaxHeight="300" Visibility="Collapsed">
                    <TextBlock x:Name="QuizText"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Expander>

        <!-- フィルター -->
        <Grid Grid.Row="3" Padding="24,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="時間フィルター:" VerticalAlignment="Center" Margin="0,0,8,0" />

            <NumberBox x:Name="FromMsBox"
                       Grid.Column="1"
                       Header="開始(ms)"
                       PlaceholderText="0"
                       Width="120"
                       Margin="0,0,8,0" />

            <NumberBox x:Name="ToMsBox"
                       Grid.Column="2"
                       Header="終了(ms)"
                       PlaceholderText="∞"
                       Width="120"
                       Margin="0,0,8,0" />

            <Button Grid.Column="3"
                    Click="OnApplyFilterClick"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,0">
                <FontIcon Glyph="&#xE71C;" FontSize="14" />
            </Button>

            <Button Grid.Column="5"
                    Click="OnClearFilterClick"
                    VerticalAlignment="Bottom">
                <FontIcon Glyph="&#xE894;" FontSize="14" />
            </Button>
        </Grid>

        <!-- チャンク一覧 -->
        <ListView x:Name="ChunksListView"
                  Grid.Row="4"
                  Padding="24,8"
                  SelectionMode="None"
                  IncrementalLoadingTrigger="Edge"
                  IncrementalLoadingThreshold="5">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TranscriptChunk">
                    <Grid Padding="12" Margin="0,4"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 時間 -->
                        <StackPanel Grid.Column="0" Grid.RowSpan="2"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Top">
                            <TextBlock FontSize="12"
                                       FontFamily="Consolas"
                                       Foreground="{ThemeResource SystemAccentColor}">
                                <Run Text="{x:Bind local:TranscriptPage.FormatMs(StartMs)}" />
                            </TextBlock>
                            <TextBlock FontSize="11"
                                       FontFamily="Consolas"
                                       Foreground="Gray">
                                <Run Text="→ " />
                                <Run Text="{x:Bind local:TranscriptPage.FormatMs(EndMs)}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- テキスト -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="{x:Bind Text}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />

                        <!-- メタ情報 -->
                        <StackPanel Grid.Column="1" Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    Margin="0,4,0,0">
                            <TextBlock FontSize="11" Foreground="Gray"
                                       Visibility="{x:Bind local:TranscriptPage.GetSpeakerVisibility(SpeakerId)}">
                                <Run Text="話者: " />
                                <Run Text="{x:Bind SpeakerId}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="Gray">
                                <Run Text="種別: " />
                                <Run Text="{x:Bind Kind}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Footer>
                <Grid Height="60">
                    <ProgressRing x:Name="LoadMoreRing"
                                  IsActive="False"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Center" />
                    <Button x:Name="LoadMoreButton"
                            Click="OnLoadMoreClick"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        さらに読み込む
                    </Button>
                </Grid>
            </ListView.Footer>
        </ListView>

        <!-- フッター -->
        <Grid Grid.Row="5" Padding="24,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="LoadedCountText"
                       FontSize="13"
                       Foreground="Gray"
                       HorizontalAlignment="Center" />
        </Grid>

        <!-- ローディング -->
        <ProgressRing x:Name="LoadingRing"
                      Grid.RowSpan="6"
                      IsActive="False"
                      Width="48" Height="48"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <!-- エラー -->
        <InfoBar x:Name="ErrorInfoBar"
                 Grid.RowSpan="6"
                 Severity="Error"
                 IsOpen="False"
                 VerticalAlignment="Top"
                 Margin="24,80,24,0" />
    </Grid>
</Page>
