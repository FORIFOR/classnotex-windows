<Page
    x:Class="ClassnoteX.WinUI.Views.SessionDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ClassnoteX.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,8">
                    <Button Command="{x:Bind ViewModel.GoBackCommand}" Background="Transparent" BorderThickness="0">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.SelectedSession.Title, Mode=OneWay}" 
                               Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <Border Background="LightGray" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                         <TextBlock Text="{x:Bind ViewModel.SelectedSession.Status, Mode=OneWay}" FontSize="12" />
                    </Border>
                </StackPanel>
            </CommandBar.Content>
            
            <AppBarButton Icon="Play" Label="Play Audio" />
            <AppBarButton Icon="Share" Label="Share" />
            <AppBarButton Icon="Delete" Label="Delete" />
        </CommandBar>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24">
             <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /> <!-- Analysis/Overview -->
                <ColumnDefinition Width="1*" /> <!-- Transcript -->
             </Grid.ColumnDefinitions>
             
             <!-- Left Pane: Analysis -->
             <ScrollViewer Grid.Column="0" Padding="0,0,24,0">
                 <StackPanel Spacing="24">
                     <!-- Overview Card -->
                     <StackPanel Spacing="8">
                         <TextBlock Text="Overview" Style="{StaticResource SubtitleTextBlockStyle}" />
                         <TextBlock Text="{x:Bind ViewModel.SelectedSession.Summary, Mode=OneWay, TargetNullValue='No summary available.'}" 
                                    TextWrapping="Wrap" />
                     </StackPanel>

                     <!-- Meta -->
                     <StackPanel Spacing="8">
                          <TextBlock Text="Metadata" FontWeight="Bold" />
                          <TextBlock Text="{x:Bind ViewModel.SelectedSession.CreatedAt, Mode=OneWay}" Foreground="Gray"/>
                          <TextBlock Text="{x:Bind ViewModel.SelectedSession.Mode, Mode=OneWay}" Foreground="Gray"/>
                     </StackPanel>
                 </StackPanel>
             </ScrollViewer>
             
             <!-- Right Pane: Transcript -->
             <Grid Grid.Column="1" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="16">
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>
                 
                 <TextBlock Text="Transcript" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>
                 
                 <ListView Grid.Row="1">
                     <!-- Placeholder for Transcript Items -->
                     <TextBlock Text="Transcription will appear here..." Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                 </ListView>
             </Grid>
        </Grid>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" />
    </Grid>
</Page>
