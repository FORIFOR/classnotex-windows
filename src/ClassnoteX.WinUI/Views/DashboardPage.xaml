<Page
    x:Class="ClassnoteX.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ClassnoteX.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="{x:Bind ViewModel.WelcomeMessage}" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <!-- Recording Actions -->
                <Button Command="{x:Bind ViewModel.StartRecordingCommand}" CommandParameter="Meeting"
                        Background="#FFF7E0" Height="100" Width="200" CornerRadius="8">
                    <StackPanel>
                        <SymbolIcon Symbol="Microphone" />
                        <TextBlock Text="New Meeting" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.StartRecordingCommand}" CommandParameter="Lecture"
                        Background="#E0F7FA" Height="100" Width="200" CornerRadius="8">
                    <StackPanel>
                        <SymbolIcon Symbol="Video" />
                        <TextBlock Text="New Lecture" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Recent Sessions" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>

            <ListView ItemsSource="{x:Bind ViewModel.RecentSessions, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="RecentSessions_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Audio" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock Text="{Binding CreatedAt}" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                            <Border Background="LightGray" CornerRadius="4" Padding="4,2">
                                <TextBlock Text="{Binding Status}" FontSize="10" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
