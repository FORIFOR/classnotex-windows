<Page
    x:Class="ClassnoteX.WinUI.Views.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ClassnoteX.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40">
            <TextBlock Text="{x:Bind ViewModel.SessionTitle}" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
            
            <!-- Timer -->
            <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" 
                       FontSize="72" FontWeight="Light" 
                       HorizontalAlignment="Center" />

            <!-- Visualizer Placeholder -->
            <ProgressBar Value="{x:Bind ViewModel.AudioLevel, Mode=OneWay}" Maximum="1.0" Width="300" />
            
            <!-- Controls -->
            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                <Button Command="{x:Bind ViewModel.StartRecordingCommand}" 
                        IsEnabled="{x:Bind ViewModel.IsRecording, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" Padding="30,15">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Microphone" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.StopRecordingCommand}" 
                        IsEnabled="{x:Bind ViewModel.IsRecording, Mode=OneWay}"
                        Padding="30,15">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Stop" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
            
             <!-- Live Transcript -->
            <Grid Width="600" Height="300" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Live Transcript" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.LiveTranscript, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StartSeconds}" FontSize="10" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
