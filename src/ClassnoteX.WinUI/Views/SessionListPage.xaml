<Page
    x:Class="ClassnoteX.WinUI.Views.SessionListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ClassnoteX.WinUI.ViewModels"
    xmlns:models="using:ClassnoteX.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
            <AutoSuggestBox QueryIcon="Find" PlaceholderText="Search sessions..." Width="300"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />
            <ComboBox PlaceholderText="Filter by Type" SelectedIndex="0">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Meetings" />
                <ComboBoxItem Content="Lectures" />
            </ComboBox>
        </StackPanel>

        <!-- List -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Session">
                    <Grid Padding="12" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding CreatedAt}" Foreground="Gray" />
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                             <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Status}" FontSize="12" />
                             </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
